{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/search", "function": "api_search" },
      { "source": "/api/extract", "function": "api_extract" },
      { "source": "/api/research", "function": "api_research" },
      { "source": "/api/crawl", "function": "api_crawl" },
      { "source": "/api/map", "function": "api_map" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312",
      "ignore": ["**/.*", "**/__pycache__/**", "**/venv/**"]
    }
  ]
}
